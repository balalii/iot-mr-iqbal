# Alamat publik portal untuk QR code (WAJIB diisi saat dipakai siswa via HP).
# Contoh: IP laptop guru di Wi-Fi sekolah, atau domain hosting.
NEXT_PUBLIC_APP_URL=http://192.168.1.10:3000

# Rahasia penandatangan sesi login. Jika kosong, dibuat otomatis di data/.session-secret
# SESSION_SECRET=ganti-dengan-string-acak-panjang

# Database SQLite yang dipakai Prisma (default: file:./data/portal.db, relatif ke folder proyek)
# DATABASE_URL=file:./data/portal.db

# Lokasi file unggahan & rahasia sesi (default: ./data)
# DATA_DIR=./data
