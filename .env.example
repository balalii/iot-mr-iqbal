# ---------- Database (PostgreSQL) ----------
# Lokal: jalankan `bunx prisma dev --name iot --detach`, lalu pakai URL postgres:// yang dicetak, misalnya:
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portal?schema=public"
# Di VPS (dari dalam container Docker, Postgres jalan di host):
# DATABASE_URL="postgresql://iot:PASSWORD@host.docker.internal:5432/iot_portal?schema=public"

# ---------- Auth ----------
# Penanda tangan sesi login. Generate: openssl rand -hex 32
# Kosong: dibuat otomatis di data/.session-secret (di Docker hilang tiap redeploy -> wajib diisi).
SESSION_SECRET=""

# Password akun `guru` yang dibuat otomatis saat server production start kalau database belum
# punya pengguna sama sekali. Kosongkan untuk dibuatkan password acak (dicetak sekali di log).
GURU_INITIAL_PASSWORD=""

# Alamat publik portal untuk QR code (WAJIB diisi saat dipakai siswa via HP).
# Lokal: IP laptop guru di Wi-Fi sekolah. Production: variable GitHub (dibaca saat build).
NEXT_PUBLIC_APP_URL="http://192.168.1.10:3000"

# ---------- Media ----------
# Cloudflare R2 (disarankan untuk production). Kalau kosong, file disimpan di disk lokal (DATA_DIR/uploads).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="iot-mr-iqbal"
# URL publik bucket (custom domain atau https://pub-xxxx.r2.dev), tanpa slash di akhir
R2_PUBLIC_URL=""
# Folder data lokal: upload tanpa R2 & rahasia sesi (default: ./data)
# DATA_DIR="./data"
